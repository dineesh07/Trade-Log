# Neon Postgres or any PostgreSQL database connection string
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication secret (used for signing secure session JWT tokens)
AUTH_SECRET="tradelog-super-secure-secret-key-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Initial seed user credentials
SEED_USER_EMAIL="trader@example.com"
SEED_USER_PASSWORD="password123"

# Timezone (IST as specified)
TZ="Asia/Kolkata"
